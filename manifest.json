{
  "manifest_version": 3,
  "name": "Mova Flow Meet Recorder",
  "version": "0.4.0",
  "description": "Record Google Meet, Teams, Zoom and Jitsi calls and transcribe them locally with Mova Flow — no cloud.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "https://meet.jit.si/*"],
      "js": ["dist/content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "https://meet.jit.si/*"],
      "js": ["dist/callAudioHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.zoom.us/*"],
      "all_frames": true,
      "js": ["dist/content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://*.zoom.us/*"],
      "all_frames": true,
      "js": ["dist/callAudioHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Start or stop recording the call in this tab"
    }
  },
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "downloads", "sidePanel", "contextMenus"],
  "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "https://meet.jit.si/*"]
}
